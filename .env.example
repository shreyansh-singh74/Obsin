# GitHub OAuth App client ID exposed to the browser by Vite.
# Required for browser OAuth/device flow.
VITE_GITHUB_CLIENT_ID=

# Server-side OAuth credentials used by Vercel functions in api/auth/*.
# GITHUB_CLIENT_ID may match VITE_GITHUB_CLIENT_ID.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: override the callback URL used by api/auth/login.
# Local default: http://localhost:3000/api/auth/callback
# Production example: https://your-app.vercel.app/api/auth/callback
GITHUB_CALLBACK_URL=

# Optional: GitHub OAuth scopes.
# Use `repo read:user` for private repositories; `public_repo read:user` may be enough for public-only usage.
GITHUB_OAUTH_SCOPE=repo read:user
