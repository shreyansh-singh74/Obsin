# GitHub OAuth — Vercel project environment variables
# Set these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values; this file documents names only.

# From your OAuth App at: github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=your_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_oauth_app_client_secret

# Optional: exact callback URL. Defaults to <deploy origin>/api/auth/callback
# GITHUB_CALLBACK_URL=https://obsin.vercel.app/api/auth/callback

# Optional: space-delimited GitHub OAuth scopes. Default: "repo read:user"
# GITHUB_OAUTH_SCOPE=repo read:user
